[
  {
    "label": "CMake: Configure (Debug w/ Profiling)",
    "command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug -DSPELT_BUILD_TEST_SCENE=ON -DENABLE_PROFILING=ON",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "CMake: Configure (Benchmark/Release)",
    "command": "cmake -B build_bench -DCMAKE_BUILD_TYPE=Release -DSPELT_BUILD_TEST_SCENE=ON -DENABLE_PROFILING=OFF",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "CMake: Build Target",
    "command": "cmake --build build",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
  {
    "label": "CMake: Run Test Scene",
    "command": "cmake --build ../build --target SpeltEngineTestScene && ../build/test_scene/SpeltEngineTestScene",
    "cwd": "$ZED_WORKTREE_ROOT/test_scene",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
  {
    "label": "CMake: Run Tests",
    "command": "cmake --build build && ./build/test/tests",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
  {
    "label": "CMake: Benchmark Test Scene",
    "command": "cmake --build ../build_bench --target SpeltEngineTestScene && MANGOHUD_CONFIG=procmem mangohud ../build_bench/test_scene/SpeltEngineTestScene",
    "cwd": "$ZED_WORKTREE_ROOT/test_scene",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
  {
    "label": "CMake: Profile Test Scene (Hotspot)",
    "command": "cmake --build ../build --target SpeltEngineTestScene && perf record --call-graph dwarf -o perf.data ../build/test_scene/SpeltEngineTestScene && hotspot perf.data",
    "cwd": "$ZED_WORKTREE_ROOT/test_scene",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
]
