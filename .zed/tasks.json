[
  {
    "label": "CMake: Configure",
    "command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "CMake: Build Target",
    "command": "cmake --build build",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
  {
    "label": "CMake: Run Test Scene",
    "command": "cmake --build ../build && ../build/test_scene/SpeltEngineTestScene",
    "cwd": "$ZED_WORKTREE_ROOT/test_scene",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
  {
    "label": "CMake: Run Tests",
    "command": "cmake --build build && ./build/test/tests",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
  {
    "label": "CMake: Benchmark Test Scene",
    "command": "cmake --build ../build && MANGOHUD_CONFIG=procmem mangohud ../build/test_scene/SpeltEngineTestScene",
    "cwd": "$ZED_WORKTREE_ROOT/test_scene",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
  {
    "label": "CMake: Profile Test Scene (Hotspot)",
    "command": "cmake --build ../build && perf record --call-graph dwarf -o perf.data ../build/test_scene/SpeltEngineTestScene && hotspot perf.data",
    "cwd": "$ZED_WORKTREE_ROOT/test_scene",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "current",
  },
]
